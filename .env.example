NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4000
DATABASE_URL=postgresql://motinder:motinder@localhost:5432/motinder?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
COOKIE_SECURE=false

# IntaSend: keep secret key server-side only.
INTASEND_TEST=true
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_REPLACE_ME
INTASEND_SECRET_KEY=ISSecretKey_test_REPLACE_ME
INTASEND_WEBHOOK_CHALLENGE=replace-with-the-challenge-you-configure-in-IntaSend
INTASEND_MONTHLY_PLAN_ID=
INTASEND_3MONTH_PLAN_ID=
INTASEND_ANNUAL_PLAN_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Motinder <no-reply@example.com>"

# SMS verification (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Push notifications (Firebase Admin)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8
